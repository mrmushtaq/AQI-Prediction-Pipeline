# Copy this file to `.env` and fill in your real values.
# Never commit the real `.env` file to version control.

# --- API Credentials ---

# Get a free token at https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# Get a free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Get a free API key at https://explore.openaq.org/register (required for historical AQI)
OPENAQ_API_KEY=your_openaq_api_key_here

# --- Location ---

# City name used for AQICN lookups (e.g. "Sukkur", "Karachi", "Lahore")
DEFAULT_CITY=Sukkur

# Coordinates used for OpenWeather lookups
OPENWEATHER_LAT=27.7052
OPENWEATHER_LON=68.8574

# --- Logging ---

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- HTTP behavior (optional, sensible defaults are used if omitted) ---

REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
